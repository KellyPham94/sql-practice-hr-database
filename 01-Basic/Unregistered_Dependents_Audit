
-- ====================================================
-- Exercise 04: Unregistered Dependents Audit
-- Level: Basic
-- Description: Retrieve all employees who do not have any registered 
--              dependents in the system using LEFT JOIN and IS NULL.
-- ====================================================

SELECT
  e.employee_id,
  CONCAT(e.first_name, ' ', e.last_name) AS full_name,
  e.email
FROM
  employees e
  LEFT JOIN dependents d ON d.employee_id = e.employee_id
WHERE
  d.employee_id IS NULL
ORDER BY
  e.employee_id;

